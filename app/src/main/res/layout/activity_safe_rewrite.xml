<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Rewrite draft" android:textColor="@color/text_primary"
            android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_rewrite_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Checking on-device availability…" android:textColor="@color/text_secondary" />
        <EditText android:id="@+id/et_rewrite_input" android:layout_width="match_parent"
            android:layout_height="150dp" android:layout_marginTop="18dp" android:gravity="top|start"
            android:hint="Write or paste a short draft…" android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp" />
        <TextView android:id="@+id/tv_char_count" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="end"
            android:text="0 / 600" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <Spinner android:id="@+id/sp_rewrite_tone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <Button android:id="@+id/btn_rewrite_draft" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Create suggestion" />
        <Button android:id="@+id/btn_retry_model" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Retry model" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Suggestion" android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView android:id="@+id/tv_rewrite_output" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="100dp"
            android:background="@drawable/bg_card" android:padding="14dp" android:text="Your rewritten draft will appear here."
            android:textColor="@color/text_secondary" android:textIsSelectable="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal">
            <Button android:id="@+id/btn_type_rewrite" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:enabled="false" android:text="Type this" />
            <Button android:id="@+id/btn_copy_rewrite" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp" android:enabled="false" android:text="Copy suggestion" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Rewriting runs through the device’s on-device AI service when supported. Review the suggestion before copying. Type this queues it for the next text field you open in another app within 30 seconds. Clipboard cleanup runs while the app is running and Android allows clipboard access."
            android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
